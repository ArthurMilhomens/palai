    },
    "Rows": {
      "SpawnPoint_1": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_TextData",
          "SourceString": "略為高起的山丘。\r\n此處視野良好，且資源豐富，\r\n是首次遊玩的好選擇。",
          "LocalizedString": "略為高起的山丘。\r\n此處視野良好，且資源豐富，\r\n是首次遊玩的好選擇。"
        }
      },
      "SpawnPoint_1_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_Title_TextData",
          "SourceString": "風起之島 初始台地",
          "LocalizedString": "風起之島 初始台地"
        }
      },
      "SpawnPoint_2": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_TextData",
          "SourceString": "海邊的沙灘。有許多水生帕魯。\r\n此處樹木稀少，但有不少帕魯棲息。",
          "LocalizedString": "海邊的沙灘。有許多水生帕魯。\r\n此處樹木稀少，但有不少帕魯棲息。"
        }
      },
      "SpawnPoint_2_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_Title_TextData",
          "SourceString": "風起之島 飛魚海岸",
          "LocalizedString": "風起之島 飛魚海岸"
        }
      },
      "SpawnPoint_3": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_TextData",
          "SourceString": "被廣闊的岩石暗礁包圍的海岸。\r\n這裡的資源和帕魯的數量較為均等。\r\n雖然岩石較多，但也有較為廣闊的平地。",
          "LocalizedString": "被廣闊的岩石暗礁包圍的海岸。\r\n這裡的資源和帕魯的數量較為均等。\r\n雖然岩石較多，但也有較為廣闊的平地。"
        }
      },
      "SpawnPoint_3_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_Title_TextData",
          "SourceString": "潮風群島 岩礁",
          "LocalizedString": "潮風群島 岩礁"
        }
      },
      "SpawnPoint_4": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_TextData",
          "SourceString": "能夠感受到海風輕拂的島嶼。\r\n距離火山很近，氣候溫暖​​宜人，十分適合居住。\r\n往來週邊島嶼也十分便利，可以享受各式各樣的冒險。",
          "LocalizedString": "能夠感受到海風輕拂的島嶼。\r\n距離火山很近，氣候溫暖​​宜人，十分適合居住。\r\n往來週邊島嶼也十分便利，可以享受各式各樣的冒險。"
        }
      },
      "SpawnPoint_4_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_Title_TextData",
          "SourceString": "潮風群島 漂流者海濱",
          "LocalizedString": "潮風群島 漂流者海濱"
        }
      },
      "SpawnPoint_5": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_TextData",
          "SourceString": "沒有人類生活跡象的島嶼。\r\n自然資源匱乏，\r\n不太適宜居住。",
          "LocalizedString": "沒有人類生活跡象的島嶼。\r\n自然資源匱乏，\r\n不太適宜居住。"
        }
      },
      "SpawnPoint_5_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_Title_TextData",
          "SourceString": "寂靜之島",
          "LocalizedString": "寂靜之島"
        }
      },
      "SpawnPoint_6": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_TextData",
          "SourceString": "地形起伏大，林木環繞的靜謐島嶼。\r\n資源和帕魯的數量都有限，\r\n因此少有人在此定居。",
          "LocalizedString": "地形起伏大，林木環繞的靜謐島嶼。\r\n資源和帕魯的數量都有限，\r\n因此少有人在此定居。"
        }
      },
      "SpawnPoint_6_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_Title_TextData",
          "SourceString": "潺鳴之島",
          "LocalizedString": "潺鳴之島"
        }
      },
      "SpawnPoint_7": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_TextData",
          "SourceString": "位於東部的荒蕪島嶼。\r\n位於大陸邊緣，沒人願意開拓這片土地。\r\n對無經驗者來說不是定居的好選擇。",
          "LocalizedString": "位於東部的荒蕪島嶼。\r\n位於大陸邊緣，沒人願意開拓這片土地。\r\n對無經驗者來說不是定居的好選擇。"
        }
      },
      "SpawnPoint_7_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_Title_TextData",
          "SourceString": "東部的荒蕪島嶼",
          "LocalizedString": "東部的荒蕪島嶼"
        }
      },
      "SpawnPoint_8": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_8_TextData",
          "SourceString": "廣闊濕地遍佈的小島。\r\n因適當的空氣濕度而生長著許多野莓。\r\n各式各樣的帕魯在這裡棲息繁衍。",
          "LocalizedString": "廣闊濕地遍佈的小島。\r\n因適當的空氣濕度而生長著許多野莓。\r\n各式各樣的帕魯在這裡棲息繁衍。"
        }
      },
      "SpawnPoint_8_Title": {
