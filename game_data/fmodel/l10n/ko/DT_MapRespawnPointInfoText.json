    "Rows": {
      "SpawnPoint_1": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_TextData",
          "SourceString": "봉긋한 언덕 위.\r\n전망이 탁 트이고 자원도 풍부한 덕에\r\n처음 플레이하는 사람에게 추천.",
          "LocalizedString": "봉긋한 언덕 위.\r\n전망이 탁 트이고 자원도 풍부한 덕에\r\n처음 플레이하는 사람에게 추천."
        }
      },
      "SpawnPoint_1_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_Title_TextData",
          "SourceString": "바람 부는 섬 - 시작의 언덕",
          "LocalizedString": "바람 부는 섬 - 시작의 언덕"
        }
      },
      "SpawnPoint_2": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_TextData",
          "SourceString": "해변의 모래사장. 수생 팰이 많다.\r\n나무는 적으나 팰이 꽤 살고 있다.",
          "LocalizedString": "해변의 모래사장. 수생 팰이 많다.\r\n나무는 적으나 팰이 꽤 살고 있다."
        }
      },
      "SpawnPoint_2_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_Title_TextData",
          "SourceString": "바람 부는 섬 - 날치 해안",
          "LocalizedString": "바람 부는 섬 - 날치 해안"
        }
      },
      "SpawnPoint_3": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_TextData",
          "SourceString": "바닷바람이 부는 섬.\r\n자원과 팰의 숫자는 평균적이다.\r\n바위가 조금 많지만, 넓은 토지를 확보할 수 있다.",
          "LocalizedString": "바닷바람이 부는 섬.\r\n자원과 팰의 숫자는 평균적이다.\r\n바위가 조금 많지만, 넓은 토지를 확보할 수 있다."
        }
      },
      "SpawnPoint_3_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_Title_TextData",
          "SourceString": "바닷바람 군도 - 암초",
          "LocalizedString": "바닷바람 군도 - 암초"
        }
      },
      "SpawnPoint_4": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_TextData",
          "SourceString": "바닷바람이 스쳐 지나가는 섬.\r\n화산과 가깝지만 기후가 온화하고 살기 좋다.\r\n주변 섬과의 접근성도 괜찮아 다양한 모험을 즐길 수 있다.",
          "LocalizedString": "바닷바람이 스쳐 지나가는 섬.\r\n화산과 가깝지만 기후가 온화하고 살기 좋다.\r\n주변 섬과의 접근성도 괜찮아 다양한 모험을 즐길 수 있다."
        }
      },
      "SpawnPoint_4_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_Title_TextData",
          "SourceString": "바닷바람 군도 - 표류자의 해안",
          "LocalizedString": "바닷바람 군도 - 표류자의 해안"
        }
      },
      "SpawnPoint_5": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_TextData",
          "SourceString": "사람의 기척이 느껴지지 않는 섬.\r\n섬에서 구할 수 있는 자원도 한정적이기에\r\n거주지로 삼기에는 적합하지 않은 듯하다.",
          "LocalizedString": "사람의 기척이 느껴지지 않는 섬.\r\n섬에서 구할 수 있는 자원도 한정적이기에\r\n거주지로 삼기에는 적합하지 않은 듯하다."
        }
      },
      "SpawnPoint_5_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_Title_TextData",
          "SourceString": "정적의 섬",
          "LocalizedString": "정적의 섬"
        }
      },
      "SpawnPoint_6": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_TextData",
          "SourceString": "고저차가 있는 지형과 나무들로 둘러싸인 조용한 섬.\r\n자원과 팰이 그리 많지는 않기에\r\n이 땅에 상주하는 사람은 적은 편이다.",
          "LocalizedString": "고저차가 있는 지형과 나무들로 둘러싸인 조용한 섬.\r\n자원과 팰이 그리 많지는 않기에\r\n이 땅에 상주하는 사람은 적은 편이다."
        }
      },
      "SpawnPoint_6_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_Title_TextData",
          "SourceString": "파도가 일렁이는 섬",
          "LocalizedString": "파도가 일렁이는 섬"
        }
      },
      "SpawnPoint_7": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_TextData",
          "SourceString": "동쪽에 위치한 황량한 섬.\r\n대륙 끝자락에 있으며, 아무도 개척하려 하지 않는다.\r\n익숙하지 않은 사람이 살기엔 좀 힘들다.",
          "LocalizedString": "동쪽에 위치한 황량한 섬.\r\n대륙 끝자락에 있으며, 아무도 개척하려 하지 않는다.\r\n익숙하지 않은 사람이 살기엔 좀 힘들다."
        }
      },
      "SpawnPoint_7_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_Title_TextData",
          "SourceString": "동쪽의 황량한 섬",
          "LocalizedString": "동쪽의 황량한 섬"
        }
      },
      "SpawnPoint_8": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_8_TextData",
          "SourceString": "습지대가 펼쳐진 섬.\r\n습도가 적당해 열매가 잔뜩 열리며\r\n다양한 종류의 팰이 서식하고 있다.",
          "LocalizedString": "습지대가 펼쳐진 섬.\r\n습도가 적당해 열매가 잔뜩 열리며\r\n다양한 종류의 팰이 서식하고 있다."
        }
      },
