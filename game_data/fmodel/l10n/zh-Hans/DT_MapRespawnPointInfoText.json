    },
    "Rows": {
      "SpawnPoint_1": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_TextData",
          "SourceString": "在一个小山丘上。\r\n不仅视野开阔，资源也极其丰富，\r\n非常适合第一次游玩的新手。",
          "LocalizedString": "在一个小山丘上。\r\n不仅视野开阔，资源也极其丰富，\r\n非常适合第一次游玩的新手。"
        }
      },
      "SpawnPoint_1_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_1_Title_TextData",
          "SourceString": "风起之岛 初始台地",
          "LocalizedString": "风起之岛 初始台地"
        }
      },
      "SpawnPoint_2": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_TextData",
          "SourceString": "海边的沙滩。有非常多的水生帕鲁。\r\n树木稀少，但有不少帕鲁栖息。",
          "LocalizedString": "海边的沙滩。有非常多的水生帕鲁。\r\n树木稀少，但有不少帕鲁栖息。"
        }
      },
      "SpawnPoint_2_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_2_Title_TextData",
          "SourceString": "风起之岛 飞鱼海岸",
          "LocalizedString": "风起之岛 飞鱼海岸"
        }
      },
      "SpawnPoint_3": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_TextData",
          "SourceString": "被广阔的岩石暗礁包围的海岸。\r\n这里的资源和帕鲁的数量较为均等。\r\n虽然岩石较多，但也有较为广阔的平地。",
          "LocalizedString": "被广阔的岩石暗礁包围的海岸。\r\n这里的资源和帕鲁的数量较为均等。\r\n虽然岩石较多，但也有较为广阔的平地。"
        }
      },
      "SpawnPoint_3_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_3_Title_TextData",
          "SourceString": "潮风群岛 岩礁",
          "LocalizedString": "潮风群岛 岩礁"
        }
      },
      "SpawnPoint_4": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_TextData",
          "SourceString": "能够感受到海风轻拂的岛屿。\r\n距离火山很近，气候温暖宜人，十分适合居住。\r\n往来周边岛屿也十分便利，可以畅享各式各样的冒险。",
          "LocalizedString": "能够感受到海风轻拂的岛屿。\r\n距离火山很近，气候温暖宜人，十分适合居住。\r\n往来周边岛屿也十分便利，可以畅享各式各样的冒险。"
        }
      },
      "SpawnPoint_4_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_4_Title_TextData",
          "SourceString": "潮风群岛 漂流者海滨",
          "LocalizedString": "潮风群岛 漂流者海滨"
        }
      },
      "SpawnPoint_5": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_TextData",
          "SourceString": "没有人类生活迹象的岛屿。\r\n自然资源匮乏，\r\n不太适宜居住。",
          "LocalizedString": "没有人类生活迹象的岛屿。\r\n自然资源匮乏，\r\n不太适宜居住。"
        }
      },
      "SpawnPoint_5_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_5_Title_TextData",
          "SourceString": "寂静之岛",
          "LocalizedString": "寂静之岛"
        }
      },
      "SpawnPoint_6": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_TextData",
          "SourceString": "地势起伏大，林木环绕的静谧岛屿。\r\n资源和帕鲁的数量都有限，\r\n因此少有人在此定居。",
          "LocalizedString": "地势起伏大，林木环绕的静谧岛屿。\r\n资源和帕鲁的数量都有限，\r\n因此少有人在此定居。"
        }
      },
      "SpawnPoint_6_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_6_Title_TextData",
          "SourceString": "潺鸣之岛",
          "LocalizedString": "潺鸣之岛"
        }
      },
      "SpawnPoint_7": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_TextData",
          "SourceString": "东部地区的荒芜之岛。\r\n位于大陆的另一头，没人想去开发。\r\n对于不习惯的人来说，在这定居可能有些困难。",
          "LocalizedString": "东部地区的荒芜之岛。\r\n位于大陆的另一头，没人想去开发。\r\n对于不习惯的人来说，在这定居可能有些困难。"
        }
      },
      "SpawnPoint_7_Title": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_7_Title_TextData",
          "SourceString": "东部的荒芜岛屿",
          "LocalizedString": "东部的荒芜岛屿"
        }
      },
      "SpawnPoint_8": {
        "TextData": {
          "Namespace": "DT_MapRespawnPointInfoText",
          "Key": "SpawnPoint_8_TextData",
          "SourceString": "遍布广阔湿地带的小岛。\r\n因适宜的空气湿度而生长着许多野莓。\r\n各种各样的帕鲁在这里繁衍生息。​",
          "LocalizedString": "遍布广阔湿地带的小岛。\r\n因适宜的空气湿度而生长着许多野莓。\r\n各种各样的帕鲁在这里繁衍生息。​"
        }
      },
      "SpawnPoint_8_Title": {
