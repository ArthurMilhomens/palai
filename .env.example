NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://palai:palai@localhost:5433/palai?schema=public
REDIS_URL=redis://localhost:6379
OPENSEARCH_NODE=http://localhost:9200
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=palai
S3_SECRET_ACCESS_KEY=palaisecret
S3_BUCKET=palai
S3_PUBLIC_URL=/storage
S3_FORCE_PATH_STYLE=true
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BOOTSTRAP_ADMIN_EMAIL=admin@palai.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:8080,http://localhost:5173
RATE_LIMIT_MAX=200
RATE_LIMIT_TIME_WINDOW_MS=60000
CACHE_TTL_SECONDS=300
UPLOAD_MAX_BYTES=314572800
